<?xml version="1.0" encoding="UTF-8"?>
<Scenario xmlns="uri:/mil/tatrc/physiology/datamodel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" contentVersion="BioGears_8.2.0">
  <Name>p5_infusion</Name>
  <Description>pybiogears probe P5 oracle: infusion</Description>
  <EngineStateFile>./states/StandardMale@0s.xml</EngineStateFile>
  <DataRequests SamplesPerSecond="1">
    <DataRequest xsi:type="LiquidCompartmentDataRequestData" Compartment="Lymph" Name="Volume" Unit="mL" Precision="10"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="BloodVolume" Unit="mL" Precision="10"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="ExtravascularFluidVolume" Unit="mL" Precision="10"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="MeanArterialPressure" Unit="mmHg" Precision="10"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="HeartRate" Unit="1/min" Precision="10"/>
  </DataRequests>
  <Actions>
    <Action xsi:type="AdvanceTimeData"><Time value="300" unit="s"/></Action>
    <Action xsi:type="SubstanceCompoundInfusionData"><SubstanceCompound>Saline</SubstanceCompound><BagVolume value="1000.0" unit="mL"/><Rate value="100.0" unit="mL/min"/></Action>
    <Action xsi:type="AdvanceTimeData"><Time value="3600" unit="s"/></Action>
  </Actions>
</Scenario>
