<?xml version="1.0" encoding="UTF-8"?>
<Scenario xmlns="uri:/mil/tatrc/physiology/datamodel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" contentVersion="BioGears_8.2.0">
  <Name>p4_hemorrhage</Name>
  <Description>pybiogears probe P4 oracle: hemorrhage</Description>
  <EngineStateFile>./states/StandardMale@0s.xml</EngineStateFile>
  <DataRequests SamplesPerSecond="1">
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="HeartRate" Unit="1/min" Precision="12"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="MeanArterialPressure" Unit="mmHg" Precision="12"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="BloodVolume" Unit="mL" Precision="12"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="CentralVenousPressure" Unit="mmHg" Precision="12"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="CardiacOutput" Unit="L/min" Precision="12"/>
    <DataRequest xsi:type="PhysiologyDataRequestData" Name="HemoglobinContent" Unit="g" Precision="12"/>
    <DataRequest xsi:type="LiquidCompartmentDataRequestData" Compartment="VenaCava" Name="Volume" Unit="mL" Precision="12"/>
  </DataRequests>
  <Actions>
    <Action xsi:type="AdvanceTimeData"><Time value="60" unit="s"/></Action>
    <Action xsi:type="HemorrhageData" Compartment="RightLeg"><InitialRate value="100.0" unit="mL/min"/></Action>
    <Action xsi:type="AdvanceTimeData"><Time value="120" unit="s"/></Action>
    <Action xsi:type="HemorrhageData" Compartment="RightLeg"><InitialRate value="250.0" unit="mL/min"/></Action>
    <Action xsi:type="AdvanceTimeData"><Time value="120" unit="s"/></Action>
    <Action xsi:type="HemorrhageData" Compartment="RightLeg"><InitialRate value="0.0" unit="mL/min"/></Action>
    <Action xsi:type="AdvanceTimeData"><Time value="600" unit="s"/></Action>
  </Actions>
</Scenario>
